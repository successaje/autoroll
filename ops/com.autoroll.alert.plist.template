<?xml version="1.0" encoding="UTF-8"?>
<!--
  Watches whether AutoRoll is rolling, every five minutes.

  A separate agent from the keeper on purpose. An alerter inside the process
  it watches says nothing when that process is what failed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autoroll.alert</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUNTIME_DIR__/scripts/alert-keeper.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>VAULT_ADDRESS</key>
    <string>__VAULT__</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__RUNTIME_DIR__/.keeper/alert.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME_DIR__/.keeper/alert.error.log</string>
</dict>
</plist>
